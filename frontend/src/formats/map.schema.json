{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jdr.local/schemas/map.schema.json",
  "title": "JDR map document",
  "description": "Map document exchanged by export / import and stored by snapshots (projet.md 12.1), format_version 1 as accepted since phase P5. Coordinates in cells (floats), origin top-left, Y down. Asset references are content hashes (sha256:<hex>), token definitions are referenced by name (ref:token:<name>). Unknown members are refused; objects (wall, door, window, light), placed tokens and fog are P5 content; notes and links come with P9 and must be empty. The client validates with src/formats/map-document.ts (same rules, plus unique ids/levels/uids (ignoring case), the three tile layers, blocks of known floors inside the grid, dim_radius >= radius, door length 0.1-20, decoded tile and fog blocks, no key named __proto__ / constructor / prototype); the server applies the same hand-written validation (app/Maps/Document/MapDocumentValidator.php, app/Maps/ObjectRules.php, app/Maps/TokenRules.php).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "name", "grid", "palette", "layers", "floors", "chunks"],
  "properties": {
    "format": {
      "const": "jdr-map"
    },
    "format_version": {
      "const": 1
    },
    "app_version": {
      "type": "string",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "kind": {
      "enum": ["battle", "world"]
    },
    "grid": {
      "$ref": "#/$defs/grid"
    },
    "theme": {
      "enum": ["parchment", "slate", "blueprint", "dark", "light"]
    },
    "ambient": {
      "$ref": "#/$defs/ambient"
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "prefixItems": [
        {
          "type": "null"
        }
      ],
      "items": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/$defs/paletteEntry"
          }
        ]
      }
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/floor"
      }
    },
    "chunks": {
      "description": "floor uid → tile layer → \"cx:cy\" → base64 of a raw-deflate tile block (projet.md 12.2). An empty map may be written [].",
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/floorUid"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 0
              },
              {
                "type": "object",
                "propertyNames": {
                  "enum": ["ground", "terrain", "decor"]
                },
                "additionalProperties": {
                  "$ref": "#/$defs/blockMap"
                }
              }
            ]
          }
        }
      ]
    },
    "fog": {
      "description": "Fog of war (projet.md 12.3): floor uid → \"cx:cy\" → base64 of the raw-deflate 2 048-byte bitmap (bit set = explored).",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/floorUid"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/fogBlockMap"
              }
            ]
          }
        }
      ]
    },
    "objects": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/object"
          }
        }
      ]
    },
    "notes": {
      "$ref": "#/$defs/laterList"
    },
    "links": {
      "$ref": "#/$defs/laterList"
    },
    "tokens_placed": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/placedToken"
          }
        }
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator", "gen_version", "seed"],
          "properties": {
            "generator": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,39}$"
            },
            "gen_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "seed": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "params": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "array",
                  "maxItems": 0
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "laterList": {
      "description": "Content of a later phase (P9): null or empty.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 0
        }
      ]
    },
    "assetRef": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "floorUid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,21}$"
    },
    "blockMap": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]{1,3}:[0-9]{1,3}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 4,
            "maxLength": 8192,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      ]
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_px", "width", "height", "unit_label", "unit_per_cell"],
      "properties": {
        "type": {
          "const": "square"
        },
        "cell_px": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "unit_label": {
          "type": "string",
          "maxLength": 10
        },
        "unit_per_cell": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 9999.99
        }
      }
    },
    "ambient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "darkness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "time_of_day": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            }
          ]
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["none", "rain", "snow", "fog", "storm"]
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "paletteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset"],
      "properties": {
        "asset": {
          "$ref": "#/$defs/assetRef"
        },
        "name": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 120
            }
          ]
        },
        "autotile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,40}$"
            }
          ]
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "enum": ["ground", "terrain", "decor", "walls", "props", "lighting", "labels", "gm"]
        },
        "kind": {
          "enum": ["tiles", "objects"]
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gm_only": {
          "type": "boolean"
        }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "level", "name"],
      "properties": {
        "uid": {
          "$ref": "#/$defs/floorUid"
        },
        "level": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S"
        }
      }
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 400
      },
      "description": "[x, y] in cells, inside the grid (checked by the validators)."
    },
    "objectUid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,21}$"
    },
    "fogBlockMap": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]{1,3}:[0-9]{1,3}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 4,
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        }
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "object": {
      "description": "Object of projet.md 12.4 (P5 types). Omitted: layer = walls (light: lighting), visibility = all, locked = false, sort_order = 0, reserved props = null.",
      "oneOf": [
        {
          "$ref": "#/$defs/wallObject"
        },
        {
          "$ref": "#/$defs/doorObject"
        },
        {
          "$ref": "#/$defs/windowObject"
        },
        {
          "$ref": "#/$defs/lightObject"
        }
      ]
    },
    "wallObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "floor", "type", "geometry", "props"],
      "properties": {
        "uid": {
          "$ref": "#/$defs/objectUid"
        },
        "floor": {
          "$ref": "#/$defs/floorUid"
        },
        "type": {
          "const": "wall"
        },
        "layer": {
          "enum": ["walls", "props", "lighting", "labels", "gm"]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["points", "closed"],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "thickness", "blocks_vision", "blocks_light", "blocks_move"],
          "properties": {
            "kind": {
              "enum": ["stone", "brick", "wood", "metal", "natural", "invisible"]
            },
            "thickness": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 2
            },
            "blocks_vision": {
              "type": "boolean"
            },
            "blocks_light": {
              "type": "boolean"
            },
            "blocks_move": {
              "type": "boolean"
            },
            "texture_asset": {
              "type": "null"
            },
            "height": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                }
              ]
            }
          }
        },
        "visibility": {
          "enum": ["all", "gm", "hidden_until_revealed"]
        },
        "locked": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "doorObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "floor", "type", "geometry", "props"],
      "properties": {
        "uid": {
          "$ref": "#/$defs/objectUid"
        },
        "floor": {
          "$ref": "#/$defs/floorUid"
        },
        "type": {
          "const": "door"
        },
        "layer": {
          "enum": ["walls", "props", "lighting", "labels", "gm"]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a", "b"],
          "properties": {
            "a": {
              "$ref": "#/$defs/point"
            },
            "b": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "locked", "secret", "swing"],
          "properties": {
            "state": {
              "enum": ["open", "closed"]
            },
            "locked": {
              "type": "boolean"
            },
            "secret": {
              "type": "boolean"
            },
            "asset_open": {
              "type": "null"
            },
            "asset_closed": {
              "type": "null"
            },
            "swing": {
              "enum": ["a", "b", "slide"]
            }
          }
        },
        "visibility": {
          "enum": ["all", "gm", "hidden_until_revealed"]
        },
        "locked": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "windowObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "floor", "type", "geometry", "props"],
      "properties": {
        "uid": {
          "$ref": "#/$defs/objectUid"
        },
        "floor": {
          "$ref": "#/$defs/floorUid"
        },
        "type": {
          "const": "window"
        },
        "layer": {
          "enum": ["walls", "props", "lighting", "labels", "gm"]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a", "b"],
          "properties": {
            "a": {
              "$ref": "#/$defs/point"
            },
            "b": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["glass", "bars", "opening"]
            }
          }
        },
        "visibility": {
          "enum": ["all", "gm", "hidden_until_revealed"]
        },
        "locked": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "lightObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "floor", "type", "geometry", "props"],
      "properties": {
        "uid": {
          "$ref": "#/$defs/objectUid"
        },
        "floor": {
          "$ref": "#/$defs/floorUid"
        },
        "type": {
          "const": "light"
        },
        "layer": {
          "enum": ["walls", "props", "lighting", "labels", "gm"]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 400
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 400
            }
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "dim_radius",
            "color",
            "intensity",
            "flicker",
            "cone",
            "enabled",
            "follows_token"
          ],
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "dim_radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "flicker": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "amp", "speed"],
              "properties": {
                "type": {
                  "enum": ["none", "torch", "pulse"]
                },
                "amp": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "speed": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 10
                }
              }
            },
            "cone": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["angle", "direction"],
                  "properties": {
                    "angle": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 359
                    },
                    "direction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    }
                  }
                }
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "follows_token": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/objectUid"
                }
              ]
            }
          }
        },
        "visibility": {
          "enum": ["all", "gm", "hidden_until_revealed"]
        },
        "locked": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "tokenLight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius", "dim_radius", "color", "intensity", "flicker"],
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "dim_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flicker": {
          "type": "boolean"
        }
      }
    },
    "placedToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "token", "floor", "x", "y"],
      "properties": {
        "uid": {
          "$ref": "#/$defs/objectUid"
        },
        "token": {
          "type": "string",
          "pattern": "^ref:token:\\S(.*\\S)?$",
          "maxLength": 90
        },
        "floor": {
          "$ref": "#/$defs/floorUid"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "rotation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 359
        },
        "scale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "hidden": {
          "type": "boolean"
        },
        "light_override": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tokenLight"
            }
          ]
        }
      }
    }
  }
}
